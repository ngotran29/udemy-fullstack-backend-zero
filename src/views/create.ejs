<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create user</title>
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body>
    <ul class="topnav">
      <li><a href="/">Home</a></li>
      <li><a href="/create" class="active">Create a user</a></li>
    </ul>
    <form class="form-add-user" action="/create-user" method="POST">
      <div class="form-add-user">
        <fieldset>
          <legend>Form add new user</legend>

          <div class="input-group">
            <label>Email: </label>
            <input type="text" name="email" />
          </div>

          <div class="input-group">
            <label>Name: </label>
            <input type="text" name="myname" />
          </div>

          <div class="input-group">
            <label>City: </label>
            <input type="text" name="city" />
          </div>

          <div>
            <button class="btn-save">Save</button>
          </div>
        </fieldset>
      </div>
    </form>
  </body>
</html>
